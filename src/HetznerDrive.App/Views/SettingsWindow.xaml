<Window x:Class="HetznerDrive.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:conv="clr-namespace:HetznerDrive.App.Views"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="{StaticResource WC.Brush.BgPrimary}"
        Title="Settings" Width="560" SizeToContent="Height" Icon="/Assets/hetznerdrive.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <conv:ProtocolToDisplayConverter x:Key="ProtocolToText"/>
    </Window.Resources>
    <StackPanel Margin="16">
        <CheckBox Content="Start HetznerDrive at login and auto-mount flagged mappings"
                  IsChecked="{Binding StartAtLogin}" Margin="0,4"/>
        <CheckBox Content="Minimize to tray instead of exiting when the window is closed"
                  IsChecked="{Binding MinimizeToTray}" Margin="0,4"/>
        <CheckBox Content="Check GitHub for updates on startup"
                  IsChecked="{Binding AutoCheckForUpdates}" Margin="0,4"/>
        <CheckBox Content="Verbose (debug) logging for mounts — remount to apply"
                  IsChecked="{Binding VerboseLogging}" Margin="0,4"
                  ToolTip="Runs rclone at DEBUG level so the activity log captures file operations (moves, renames, errors)."/>

        <Separator Margin="0,10"/>
        <TextBlock Text="Protocol selection" FontWeight="SemiBold" Margin="0,4"/>
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Default for new mappings" VerticalAlignment="Center"/>
            <ComboBox  Grid.Row="0" Grid.Column="1" Margin="0,4"
                       ItemsSource="{Binding Protocols}" SelectedItem="{Binding DefaultProtocol}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource ProtocolToText}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Benchmark payload (MiB)" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding BenchmarkPayloadMiB}"
                       ToolTip="How much data the Auto benchmark moves each way, per protocol. Bigger is more accurate and slower."/>
        </Grid>
        <CheckBox Content="Re-measure on every mount instead of reusing the last result"
                  IsChecked="{Binding AlwaysReBenchmark}" Margin="0,4"
                  ToolTip="Useful on a laptop that moves between very different networks. Otherwise the winner is cached for two weeks."/>

        <Separator Margin="0,10"/>
        <TextBlock Text="Default cache settings for new mappings" FontWeight="SemiBold" Margin="0,4"/>
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cache mode" VerticalAlignment="Center"/>
            <ComboBox  Grid.Row="0" Grid.Column="1" Margin="0,4"
                       ItemsSource="{Binding CacheModes}" SelectedItem="{Binding DefaultCacheMode}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cache max size (MiB)" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding DefaultCacheMaxSizeMb}"
                       ToolTip="0 = unlimited. 1 TiB = 1048576."/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Cache max age (hours)" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding DefaultCacheMaxAgeHours}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Cache location" VerticalAlignment="Center"/>
            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
                <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseCacheDir"
                        Padding="10,2" Margin="6,0,0,0"/>
                <TextBox Text="{Binding DefaultCacheDir}"
                         ToolTip="Blank = rclone default. Use a drive with room for the cache size."/>
            </DockPanel>
        </Grid>

        <Separator Margin="0,10"/>
        <TextBlock Text="Windows service" FontWeight="SemiBold" Margin="0,4"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11"
                   Foreground="{StaticResource WC.Brush.TextSecondary}"
                   Text="Mounts marked &quot;Mount with the Windows service&quot; are kept available before anyone signs in and survive logoff. They must use a folder mountpoint — a drive letter only exists inside the session that created it. Files On-Demand folders always need an interactive session and cannot be serviced. Installing and updating the service needs administrator approval."/>
        <TextBlock x:Name="ServiceStatusText" Margin="0,0,0,6" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="InstallServiceButton" Content="Install / update" Click="OnInstallService"
                    Style="{StaticResource WC.Button.Accent}" Padding="14,6" Margin="0,0,8,0"/>
            <Button x:Name="PublishServiceButton" Content="Apply changes" Click="OnPublishService"
                    Padding="14,6" Margin="0,0,8,0"/>
            <Button x:Name="UninstallServiceButton" Content="Uninstall" Click="OnUninstallService"
                    Style="{StaticResource WC.Button.Danger}" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="Service logs" Click="OnOpenServiceLogs" Padding="14,6"/>
        </StackPanel>

        <Separator Margin="0,10"/>
        <TextBlock Text="rclone.exe path (leave blank to auto-detect)" Margin="0,4"/>
        <TextBox Text="{Binding RcloneExePath}" Margin="0,4"/>

        <Separator Margin="0,10"/>
        <TextBlock Text="Backup / transfer" FontWeight="SemiBold" Margin="0,4"/>
        <TextBlock Text="Exports settings and mappings (no passwords or keys) as JSON or XML."
                   Foreground="{StaticResource WC.Brush.TextSecondary}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="Export…" Click="OnExport" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="Import…" Click="OnImport" Padding="14,6"/>
            <Button Content="Open logs folder" Click="OnOpenLogs" Padding="14,6" Margin="8,0,0,0"/>
            <Button Content="About…" Click="OnAbout" Padding="14,6" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Click="OnSave" IsDefault="True" Style="{StaticResource WC.Button.Accent}" Padding="18,6" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True" Padding="18,6"/>
        </StackPanel>
    </StackPanel>
</Window>
