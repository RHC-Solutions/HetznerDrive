<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>HetznerDrive</AssemblyName>
    <RootNamespace>HetznerDrive.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\hetznerdrive.ico</ApplicationIcon>
    <Product>HetznerDrive</Product>
    <Version>0.1.0</Version>
    <Company>RHC Solutions</Company>
    <Authors>RHC Solutions</Authors>
    <Copyright>© RHC Solutions. https://rhcsolutions.com/</Copyright>
    <PackageProjectUrl>https://rhcsolutions.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RHC-Solutions/HetznerDrive</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HetznerDrive.Core\HetznerDrive.Core.csproj" />
    <ProjectReference Include="..\HetznerDrive.CloudFiles\HetznerDrive.CloudFiles.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\hetznerdrive.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

  <!-- Bundle rclone.exe next to the app so AppPaths.ResolveRcloneExe finds it at runtime. -->
  <ItemGroup>
    <Content Include="..\..\third_party\rclone\rclone.exe" Link="rclone.exe" Condition="Exists('..\..\third_party\rclone\rclone.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
